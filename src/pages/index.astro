---
import ProjectCardImage from '../components/ProjectCardImage.astro';
import RowCard from '../components/RowCard.astro';
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { siteUrl } from '../lib/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
	.filter((p) => p.data.featured)
	.slice(0, 4);
const lessonCounts = new Map<string, number>();
for (const lesson of await getCollection('tutorials', ({ data }) => !data.draft)) {
	lessonCounts.set(lesson.data.project, (lessonCounts.get(lesson.data.project) ?? 0) + 1);
}

const writing = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);
const experiments = (await getCollection('experiments', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Base
	title="Engineering Notebook"
	description="Engineering notes on data systems, AI agents, and the tools I build to understand them."
>
	<section class="intro">
		<h1>Engineering Notebook</h1>
		<p class="statement">
			Engineering notes on data systems, AI agents, and the tools I build to understand them.
		</p>
		<p class="scope">
			Every project here was actually built. Every claim is backed by code, tests, or measurements
			— and the failures are documented alongside the results.
		</p>
	</section>

	{projects.length > 0 && (
		<section>
			<div class="section-head">
				<h2>Featured projects</h2>
				<a href={siteUrl('/projects/')}>All projects &rarr;</a>
			</div>
			<ul class="card-grid">
				{projects.map((project) => (
					<ProjectCardImage project={project} lessonCount={lessonCounts.get(project.id) ?? 0} />
				))}
			</ul>
		</section>
	)}

	{writing.length > 0 && (
		<section>
			<div class="section-head">
				<h2>Latest writing</h2>
				<a href={siteUrl('/blog/')}>All writing &rarr;</a>
			</div>
			<ul class="row-list">
				{writing.map((post) => (
					<RowCard
						kicker="Notes"
						title={post.data.title}
						href={siteUrl(`/blog/${post.id}/`)}
						description={post.data.description}
						meta={post.data.pubDate.toISOString().slice(0, 10)}
					/>
				))}
			</ul>
		</section>
	)}

	{experiments.length > 0 && (
		<section>
			<div class="section-head">
				<h2>Experiments</h2>
				<a href={siteUrl('/experiments/')}>All experiments &rarr;</a>
			</div>
			<ul class="row-list">
				{experiments.map((experiment) => (
					<RowCard
						kicker={experiment.data.category}
						title={experiment.data.title}
						href={siteUrl(`/experiments/${experiment.id}/`)}
						description={experiment.data.description}
						meta={`${experiment.data.status} · ${experiment.data.pubDate.toISOString().slice(0, 10)}`}
					/>
				))}
			</ul>
		</section>
	)}
</Base>

<style>
	.intro {
		padding: 2em 0 1em 0;
	}
	.intro h1 {
		font-size: clamp(2.2rem, 6vw, 3.4rem);
		margin-bottom: 0.25em;
	}
	.statement {
		font-size: 1.25em;
		line-height: 1.55;
		max-width: 34em;
		margin-bottom: 0.75em;
	}
	.scope {
		color: rgb(var(--gray));
		max-width: 38em;
	}
	section {
		margin-top: var(--space-6);
	}
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		border-bottom: var(--border);
		padding-bottom: 0.5em;
		margin-bottom: 0.25em;
	}
	.section-head h2 {
		font-size: 1.4rem;
		margin: 0;
	}
	.section-head a {
		font-size: 0.9rem;
		white-space: nowrap;
	}
</style>
