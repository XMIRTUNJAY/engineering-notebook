---
import { getCollection } from 'astro:content';
import { siteUrl } from '../../lib/site';

type Props = {
	currentId: string;
	kind: 'project' | 'lesson';
	tags?: string[];
	series?: string;
	project?: string;
	limit?: number;
};

const { currentId, kind, tags = [], series, project, limit = 3 } = Astro.props;

type Item = { title: string; href: string; note: string };
const items: Item[] = [];

if (kind === 'project') {
	const projects = await getCollection('projects', ({ data }) => !data.draft);
	const scored = projects
		.filter((p) => p.id !== currentId)
		.map((p) => {
			const overlap = p.data.stack.filter((t) =>
				tags.map((x) => x.toLowerCase()).includes(t.toLowerCase())
			).length;
			const sameCategory = p.data.category === tags[0] ? 1 : 0;
			return { p, score: overlap * 2 + sameCategory };
		})
		.sort((a, b) => b.score - a.score)
		.slice(0, limit);
	for (const s of scored) {
		items.push({
			title: s.p.data.title,
			href: siteUrl(`/projects/${s.p.id}/`),
			note: s.p.data.category,
		});
	}
} else {
	const lessons = await getCollection('tutorials', ({ data }) => !data.draft);
	const others = lessons
		.filter((l) => l.id !== currentId && (l.data.series === series || l.data.project === project))
		.sort((a, b) => a.data.part - b.data.part)
		.slice(0, limit);
	for (const l of others) {
		items.push({
			title: `Part ${l.data.part}: ${l.data.title}`,
			href: siteUrl(`/tutorials/${l.data.series}/${l.id.split('/').slice(1).join('/')}/`),
			note: l.data.series,
		});
	}
}
---

{items.length > 0 && (
	<section class="related" aria-label="Related content">
		<h2>Related</h2>
		<ul>
			{items.map((item) => (
				<li>
					<a href={item.href}>{item.title}</a>
					<span>{item.note}</span>
				</li>
			))}
		</ul>
	</section>
)}

<style>
	.related {
		margin-top: var(--space-5);
		padding-top: var(--space-3);
		border-top: var(--border);
	}
	.related ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.related li {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		padding: 0.6em 0;
		border-bottom: var(--border);
	}
	.related li:last-child {
		border-bottom: none;
	}
	.related span {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
</style>
